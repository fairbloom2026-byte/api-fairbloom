SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
OTP_EXPIRY_MINUTES=
BACKUP_DIR=
BACKUP_PASSPHRASE=
# Delete verification documents once an admin has decided (recommended)
KEEP_VERIFICATION_DOCS=
